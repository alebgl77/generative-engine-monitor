FROM node:22-alpine

# Prisma's query and schema engines link against OpenSSL, which the Alpine base
# does not carry. Without it the engine fails to load and every Prisma command —
# generate, migrate, the app itself — dies on startup.
RUN apk add --no-cache openssl

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY . .

COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 3000

# Only the dedicated Compose migrator passes "migrate" to this entrypoint.
# Web and worker start after that one-shot service completes successfully.
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
