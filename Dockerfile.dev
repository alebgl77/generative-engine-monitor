FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY . .

COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 3000

# The development stack boots through the same entrypoint as production, so the
# migrate-and-seed step cannot be skipped by overriding the command.
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
