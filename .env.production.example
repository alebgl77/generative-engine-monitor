# Copy to a protected, untracked .env.production (chmod 600). Blank secrets are
# intentional: Compose refuses to start until independently generated values exist.
POSTGRES_USER=gem
POSTGRES_DB=gem
POSTGRES_PASSWORD=
# URI-encode the password. Internal Compose host is postgres, port 5432.
# Include ?connect_timeout=3&pool_timeout=3&connection_limit=10 for bounded pools.
DATABASE_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# Closed by default for a private launch. Bootstrap only over a private tunnel:
# docs/access-control.md. Recreate the web service after changing this value.
REGISTRATION_ENABLED=false
CREDENTIAL_KEYS=
CREDENTIAL_KEY_CURRENT=1
CREDENTIAL_FINGERPRINT_PEPPER=

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
TRUSTED_PROXY_HOPS=0
WORKER_REPLICAS=1
WORKER_BATCH_SIZE=5
MAX_SAMPLES_PER_RUN=1000
MAX_SAMPLES_PER_USER_DAY=10000
MAX_ACTIVE_RUNS_PER_USER=3
MAX_QUERIES_PER_PROJECT=1000
SENTIMENT_ENABLED=true
LOG_LEVEL=info
# Review provider model availability and set the existing OPENAI_MODEL,
# ANTHROPIC_MODEL, GEMINI_MODEL, PERPLEXITY_MODEL and SENTIMENT_JUDGE_MODEL
# overrides as needed. Do not put provider API keys in this file: use the vault UI.
