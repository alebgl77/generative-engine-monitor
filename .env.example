##
## Generative Engine Monitor — configuration
##
## Quickstart:  cp .env.example .env  &&  npm run keygen   (then paste the generated secrets below)
##

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=gem
POSTGRES_PASSWORD=gem_dev_only_change_me
POSTGRES_DB=gem
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gem:gem_dev_only_change_me@localhost:5432/gem

# ─── Application ─────────────────────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32   (or npm run keygen)
# The application REFUSES to start in production while this holds the example value.
NEXTAUTH_SECRET=change-me-in-production-please

# ─── Provider credential encryption ──────────────────────────────────────────
# Provider API keys are encrypted at rest with AES-256-GCM. CREDENTIAL_KEYS maps a
# key version to a base64-encoded 32-byte key; CREDENTIAL_KEY_CURRENT selects the
# one used for new writes. To rotate: add version 2, set CURRENT=2, and leave
# version 1 in place so existing rows stay readable.
# Generate all three with: npm run keygen
# These example values are DEVELOPMENT ONLY and are rejected in production.
CREDENTIAL_KEYS={"1":"ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE="}
CREDENTIAL_KEY_CURRENT=1
CREDENTIAL_FINGERPRINT_PEPPER=dev-only-pepper-change-me-in-production

# ─── Model selection ─────────────────────────────────────────────────────────
# Model ids are configuration, not code: providers retire models on their own
# schedule, and a hardcoded id turns into a silent outage the day it is pulled.
# Defaults below were current as of August 2026.
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash
PERPLEXITY_MODEL=sonar

# ─── Sentiment judge ─────────────────────────────────────────────────────────
# Mention sentiment is scored by an LLM judge, using the credential the user
# already stored for that provider. Disable to skip the rule entirely.
SENTIMENT_ENABLED=true
SENTIMENT_JUDGE_PROVIDER=openai
SENTIMENT_JUDGE_MODEL=gpt-5.6-luna

# ─── Worker ──────────────────────────────────────────────────────────────────
# Identifies this worker in job leases. Leave empty to derive one from the hostname.
WORKER_ID=
WORKER_BATCH_SIZE=5

# ─── Demo data ───────────────────────────────────────────────────────────────
# Seeds a demo account with a randomly generated password, printed once at seed
# time. Refused in production.
SEED_DEMO=false
